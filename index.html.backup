<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio Profesional - Marc van der Biest</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --text-color: #333;
            --light-bg: #ecf0f1;
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: var(--text-color);
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 60px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" fill="%23ffffff"></path><path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5" fill="%23ffffff"></path><path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" fill="%23ffffff"></path></svg>') no-repeat bottom;
            background-size: cover;
            opacity: 0.1;
        }

        h1 {
            font-size: 3em;
            margin-bottom: 10px;
            font-weight: 700;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 1;
        }

        .subtitle {
            font-size: 1.3em;
            opacity: 0.95;
            font-weight: 300;
            position: relative;
            z-index: 1;
        }

        nav {
            background: var(--light-bg);
            padding: 20px;
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            border-bottom: 3px solid var(--secondary-color);
        }

        nav button {
            background: white;
            border: 2px solid var(--secondary-color);
            color: var(--secondary-color);
            padding: 12px 30px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 1em;
            font-weight: 600;
            transition: var(--transition);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        nav button:hover,
        nav button.active {
            background: var(--secondary-color);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
        }

        .content {
            padding: 40px;
        }

        .section {
            display: none;
            animation: fadeIn 0.5s ease-in;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .intro-section {
            text-align: center;
            padding: 40px 0;
        }

        .intro-section h2 {
            color: var(--primary-color);
            font-size: 2.5em;
            margin-bottom: 20px;
        }

        .intro-section p {
            font-size: 1.2em;
            color: #666;
            max-width: 800px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }

        .project-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: var(--transition);
            border: 1px solid #e0e0e0;
        }

        .project-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }

        .project-image {
            width: 100%;
            height: 250px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3em;
            font-weight: bold;
            position: relative;
            overflow: hidden;
        }

        .project-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .project-image::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.3) 100%);
        }

        .project-content {
            padding: 25px;
        }

        .project-title {
            color: var(--primary-color);
            font-size: 1.8em;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .project-description {
            color: #666;
            font-size: 1em;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

        .tag {
            background: var(--light-bg);
            color: var(--primary-color);
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
        }

        .project-details {
            border-top: 1px solid #e0e0e0;
            padding-top: 15px;
            font-size: 0.95em;
            color: #666;
        }

        .project-details strong {
            color: var(--secondary-color);
        }

        .skills-section {
            margin-top: 30px;
        }

        .skills-category {
            margin-bottom: 40px;
        }

        .skills-category h3 {
            color: var(--primary-color);
            font-size: 1.8em;
            margin-bottom: 20px;
            border-left: 4px solid var(--secondary-color);
            padding-left: 15px;
        }

        .skills-list {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .skill-item {
            background: linear-gradient(135deg, var(--secondary-color), #5dade2);
            color: white;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            transition: var(--transition);
        }

        .skill-item:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25);
        }

        .timeline {
            position: relative;
            padding: 20px 0;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--secondary-color);
            transform: translateX(-50%);
        }

        .timeline-item {
            margin-bottom: 50px;
            position: relative;
        }

        .timeline-item:nth-child(odd) .timeline-content {
            margin-left: 0;
            margin-right: 52%;
            text-align: right;
        }

        .timeline-item:nth-child(even) .timeline-content {
            margin-left: 52%;
        }

        .timeline-content {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: var(--card-shadow);
            position: relative;
        }

        .timeline-dot {
            position: absolute;
            left: 50%;
            top: 20px;
            width: 20px;
            height: 20px;
            background: var(--secondary-color);
            border: 4px solid white;
            border-radius: 50%;
            transform: translateX(-50%);
            box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.2);
        }

        .timeline-date {
            color: var(--secondary-color);
            font-weight: 700;
            font-size: 1.1em;
            margin-bottom: 10px;
        }

        .timeline-title {
            color: var(--primary-color);
            font-size: 1.5em;
            margin-bottom: 10px;
            font-weight: 700;
        }

        footer {
            background: var(--primary-color);
            color: white;
            text-align: center;
            padding: 30px;
            margin-top: 0;
        }

        .contact-info {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1em;
        }

        .scroll-indicator {
            position: fixed;
            top: 0;
            left: 0;
            height: 4px;
            background: var(--accent-color);
            z-index: 1000;
            transition: width 0.1s ease;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2em;
            }

            .projects-grid {
                grid-template-columns: 1fr;
            }

            .timeline::before {
                left: 20px;
            }

            .timeline-item:nth-child(odd) .timeline-content,
            .timeline-item:nth-child(even) .timeline-content {
                margin-left: 60px;
                margin-right: 0;
                text-align: left;
            }

            .timeline-dot {
                left: 20px;
            }

            nav {
                gap: 10px;
            }

            nav button {
                padding: 10px 20px;
                font-size: 0.9em;
            }
        }

        .fade-in {
            animation: fadeIn 0.8s ease-in;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1 class="fade-in">Marc van der Biest</h1>
            <p class="subtitle fade-in">Portfolio Profesional - Desarrollador Full Stack</p>
        </header>

        <nav>
            <button class="nav-btn active" data-section="inicio">Inicio</button>
            <button class="nav-btn" data-section="proyectos">Proyectos</button>
            <button class="nav-btn" data-section="experiencia">Experiencia</button>
            <button class="nav-btn" data-section="habilidades">Habilidades</button>
            <button class="nav-btn" data-section="contacto">Contacto</button>
        </nav>

        <div class="content">
            <!-- Sección Inicio -->
            <div class="section active" id="inicio">
                <div class="intro-section">
                    <h2>Bienvenido a mi Portfolio</h2>
                    <p>
                        Desarrollador Full Stack con amplia experiencia en el desarrollo de aplicaciones web y móviles.
                        Apasionado por crear soluciones innovadoras y eficientes que impacten positivamente en los negocios.
                        Experiencia en múltiples tecnologías y frameworks modernos, con un enfoque en la calidad del código
                        y las mejores prácticas de desarrollo.
                    </p>
                    <p>
                        A lo largo de mi carrera he participado en diversos proyectos que abarcan desde aplicaciones financieras
                        hasta herramientas de control de gastos y sistemas de gestión empresarial.
                    </p>
                </div>
            </div>

            <!-- Sección Proyectos -->
            <div class="section" id="proyectos">
                <h2 style="color: var(--primary-color); font-size: 2.5em; margin-bottom: 30px; text-align: center;">Proyectos Destacados</h2>
                
                <div class="projects-grid">
                    <!-- Proyecto 1: Cost Control -->
                    <div class="project-card">
                        <div class="project-image">
                            <img src="./images/cost-control.png" alt="Cost Control" onerror="this.parentElement.innerHTML='<span>💰</span>'">
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Cost Control</h3>
                            <p class="project-description">
                                Aplicación móvil multiplataforma para el control y seguimiento de gastos personales y familiares.
                                Permite registrar gastos, categorizar transacciones, generar informes detallados y visualizar
                                estadísticas de gastos por período.
                            </p>
                            <div class="project-tags">
                                <span class="tag">Flutter</span>
                                <span class="tag">Dart</span>
                                <span class="tag">Firebase</span>
                                <span class="tag">SQLite</span>
                            </div>
                            <div class="project-details">
                                <p><strong>Rol:</strong> Desarrollador Principal</p>
                                <p><strong>Logros:</strong> Gestión eficiente de presupuestos familiares con interfaz intuitiva</p>
                            </div>
                        </div>
                    </div>

                    <!-- Proyecto 2: Allfunds Bank Frontend -->
                    <div class="project-card">
                        <div class="project-image">
                            <img src="./images/afb-frontend.png" alt="Allfunds Bank" onerror="this.parentElement.innerHTML='<span>🏦</span>'">
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Allfunds Bank Frontend</h3>
                            <p class="project-description">
                                Desarrollo del frontend para la plataforma de banca digital de Allfunds. Sistema complejo
                                de gestión de fondos de inversión con múltiples dashboards, reportes en tiempo real y
                                operaciones financieras seguras.
                            </p>
                            <div class="project-tags">
                                <span class="tag">Angular</span>
                                <span class="tag">TypeScript</span>
                                <span class="tag">RxJS</span>
                                <span class="tag">Material Design</span>
                            </div>
                            <div class="project-details">
                                <p><strong>Rol:</strong> Frontend Developer</p>
                                <p><strong>Logros:</strong> Interface moderna y responsiva para gestión de fondos de inversión</p>
                            </div>
                        </div>
                    </div>

                    <!-- Proyecto 3: VizPro Extranet -->
                    <div class="project-card">
                        <div class="project-image">
                            <img src="./images/vizpro.png" alt="VizPro Extranet" onerror="this.parentElement.innerHTML='<span>📊</span>'">
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">VizPro Extranet</h3>
                            <p class="project-description">
                                Plataforma extranet para la gestión y visualización de datos empresariales. Sistema completo
                                con autenticación, gestión de usuarios, generación de reportes y dashboards interactivos
                                para análisis de negocio.
                            </p>
                            <div class="project-tags">
                                <span class="tag">React</span>
                                <span class="tag">Node.js</span>
                                <span class="tag">MongoDB</span>
                                <span class="tag">D3.js</span>
                            </div>
                            <div class="project-details">
                                <p><strong>Rol:</strong> Full Stack Developer</p>
                                <p><strong>Logros:</strong> Sistema completo de visualización de datos y gestión empresarial</p>
                            </div>
                        </div>
                    </div>

                    <!-- Proyecto 4: Grupo Life -->
                    <div class="project-card">
                        <div class="project-image">
                            <img src="./images/grupo-life.png" alt="Grupo Life" onerror="this.parentElement.innerHTML='<span>🏥</span>'">
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Grupo Life</h3>
                            <p class="project-description">
                                Sistema de gestión para grupo empresarial del sector salud. Incluye módulos de gestión
                                de pacientes, citas, historiales médicos y facturación. Arquitectura escalable y
                                segura cumpliendo con normativas de protección de datos sanitarios.
                            </p>
                            <div class="project-tags">
                                <span class="tag">Vue.js</span>
                                <span class="tag">Express</span>
                                <span class="tag">PostgreSQL</span>
                                <span class="tag">Docker</span>
                            </div>
                            <div class="project-details">
                                <p><strong>Rol:</strong> Backend & DevOps</p>
                                <p><strong>Logros:</strong> Sistema seguro y escalable para gestión sanitaria</p>
                            </div>
                        </div>
                    </div>

                    <!-- Proyecto 5: Invoice Creator -->
                    <div class="project-card">
                        <div class="project-image">
                            <img src="./images/invoice-creator.png" alt="Invoice Creator" onerror="this.parentElement.innerHTML='<span>📄</span>'">
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Invoice Creator</h3>
                            <p class="project-description">
                                Aplicación web para la creación y gestión de facturas profesionales. Incluye plantillas
                                personalizables, cálculos automáticos de impuestos, gestión de clientes y exportación
                                a PDF. Ideal para freelancers y pequeñas empresas.
                            </p>
                            <div class="project-tags">
                                <span class="tag">JavaScript</span>
                                <span class="tag">HTML5</span>
                                <span class="tag">CSS3</span>
                                <span class="tag">PDF.js</span>
                            </div>
                            <div class="project-details">
                                <p><strong>Rol:</strong> Desarrollador Full Stack</p>
                                <p><strong>Logros:</strong> Herramienta intuitiva para facturación profesional</p>
                            </div>
                        </div>
                    </div>

                    <!-- Proyecto 6: Flutter Framework -->
                    <div class="project-card">
                        <div class="project-image">
                            <img src="./images/flutter.png" alt="Flutter" onerror="this.parentElement.innerHTML='<span>📱</span>'">
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Contribución a Flutter</h3>
                            <p class="project-description">
                                Participación en el desarrollo y mejora del framework Flutter. Contribuciones incluyen
                                corrección de bugs, optimización de rendimiento y desarrollo de widgets personalizados.
                                Colaboración activa con la comunidad open source.
                            </p>
                            <div class="project-tags">
                                <span class="tag">Flutter</span>
                                <span class="tag">Dart</span>
                                <span class="tag">Open Source</span>
                                <span class="tag">Mobile Development</span>
                            </div>
                            <div class="project-details">
                                <p><strong>Rol:</strong> Contributor</p>
                                <p><strong>Logros:</strong> Mejoras en rendimiento y nuevas funcionalidades</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección Experiencia -->
            <div class="section" id="experiencia">
                <h2 style="color: var(--primary-color); font-size: 2.5em; margin-bottom: 30px; text-align: center;">Experiencia Profesional</h2>
                
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">2024 - Presente</div>
                            <h3 class="timeline-title">Senior Full Stack Developer</h3>
                            <p><strong>TMC - Allfunds Bank</strong></p>
                            <p>
                                Desarrollo de aplicaciones frontend para plataforma bancaria digital. Implementación de
                                funcionalidades complejas con Angular y TypeScript. Colaboración con equipos backend
                                y diseño para entregar soluciones de alta calidad.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">2023 - 2024</div>
                            <h3 class="timeline-title">Full Stack Developer</h3>
                            <p><strong>VizPro & Grupo Life</strong></p>
                            <p>
                                Desarrollo de sistemas empresariales completos. Arquitectura de soluciones escalables
                                utilizando tecnologías modernas. Implementación de APIs RESTful y interfaces de usuario
                                responsivas.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">2022 - 2023</div>
                            <h3 class="timeline-title">Mobile Developer</h3>
                            <p><strong>Proyectos Personales</strong></p>
                            <p>
                                Desarrollo de aplicaciones móviles multiplataforma con Flutter. Enfoque en UX/UI
                                y rendimiento. Publicación de aplicaciones en Google Play Store y App Store.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">2021 - 2022</div>
                            <h3 class="timeline-title">Junior Developer</h3>
                            <p><strong>Varios Proyectos</strong></p>
                            <p>
                                Inicio en el desarrollo profesional de software. Aprendizaje de tecnologías web modernas
                                y mejores prácticas de desarrollo. Participación en proyectos de diferentes sectores.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección Habilidades -->
            <div class="section" id="habilidades">
                <h2 style="color: var(--primary-color); font-size: 2.5em; margin-bottom: 30px; text-align: center;">Habilidades Técnicas</h2>
                
                <div class="skills-section">
                    <div class="skills-category">
                        <h3>Frontend Development</h3>
                        <div class="skills-list">
                            <div class="skill-item">Angular</div>
                            <div class="skill-item">React</div>
                            <div class="skill-item">Vue.js</div>
                            <div class="skill-item">TypeScript</div>
                            <div class="skill-item">JavaScript</div>
                            <div class="skill-item">HTML5</div>
                            <div class="skill-item">CSS3</div>
                            <div class="skill-item">SASS/SCSS</div>
                            <div class="skill-item">Material Design</div>
                            <div class="skill-item">Bootstrap</div>
                            <div class="skill-item">Responsive Design</div>
                        </div>
                    </div>

                    <div class="skills-category">
                        <h3>Backend Development</h3>
                        <div class="skills-list">
                            <div class="skill-item">Node.js</div>
                            <div class="skill-item">Express</div>
                            <div class="skill-item">REST APIs</div>
                            <div class="skill-item">GraphQL</div>
                            <div class="skill-item">Microservices</div>
                            <div class="skill-item">Authentication & Security</div>
                        </div>
                    </div>

                    <div class="skills-category">
                        <h3>Mobile Development</h3>
                        <div class="skills-list">
                            <div class="skill-item">Flutter</div>
                            <div class="skill-item">Dart</div>
                            <div class="skill-item">Android</div>
